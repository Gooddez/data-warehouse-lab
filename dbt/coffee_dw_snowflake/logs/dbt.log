join "coffee_dw_snowflake"."dbt_marts"."dim_staff" sf
  on s.staff_code = sf.staff_code
left join "coffee_dw_snowflake"."dbt_marts"."dim_promotion" pr
  on s.promo_code = pr.promo_code
  );
  
