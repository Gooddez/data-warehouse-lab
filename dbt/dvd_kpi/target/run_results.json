"unique_id": "model.dvd_kpi.fct_rental_activity", "compiled": true, "compiled_code": "with rental as (\n    select * from \"dvdrental\".\"dbt_staging\".\"stg_rental\"\n),\ninventory as (\n    select * from \"dvdrental\".\"dbt_staging\".\"stg_inventory\"\n),\nfilm as (\n    select * from \"dvdrental\".\"dbt_staging\".\"stg_film\"\n),\npayment_by_rental as (\n    select * from \"dvdrental\".\"dbt_intermediate\".\"int_payment_by_rental\"\n)\nselect\n    r.rental_id,\n    r.rental_date,\n    date_trunc('month', r.rental_date)::date as rental_month,\n    r.return_date,\n    r.customer_id,\n    r.staff_id,\n    i.store_id,\n    i.film_id,\n    f.film_title,\n    f.rating,\n    f.rental_duration,\n    r.rental_date\n        + (f.rental_duration * interval '1 day')\n        as expected_return_datetime,\n    coalesce(p.revenue_amount, 0)::numeric(12, 2)\n        as revenue_amount,\n    coalesce(p.payment_record_count, 0)::integer\n        as payment_record_count,\n    1::integer as rental_count,\n    case\n        when r.return_date is not null then 1\n        else 0\n    end::integer as returned_rental_count,\n    case\n        when r.return_date is not null\n         and r.return_date >\n             r.rental_date\n             + (f.rental_duration * interval '1 day')\n        then 1\n        else 0\n    end::integer as late_rental_count\nfrom rental r\njoin inventory i\n  on r.inventory_id = i.inventory_id\njoin film f\n  on i.film_id = f.film_id\nleft join payment_by_rental p\n  on r.rental_id = p.rental_id", "relation_name": "\"dvdrental\".\"dbt_metrics\".\"fct_rental_activity\"", "batch_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-07-15T05:32:46.777160Z", "completed_at": "2026-07-15T05:32:46.806067Z"}, {"name": "execute", "started_at": "2026-07-15T05:32:46.807844Z", "completed_at": "2026-07-15T05:32:46.864729Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 0.10577630996704102, "adapter_response": {"_message": "SELECT 1